<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer. The shooting history and the weapons library stay on the device: they are
  excluded from cloud backup and from device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sessions_history.json" />
        <exclude domain="file" path="weapons_library.json" />
        <exclude domain="file" path="ammo_library.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="sessions_history.json" />
        <exclude domain="file" path="weapons_library.json" />
        <exclude domain="file" path="ammo_library.json" />
    </device-transfer>
</data-extraction-rules>
