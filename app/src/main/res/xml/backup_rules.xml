<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older (full backup). The shooting history and the weapons library stay on the
  device, as the README promises: they are not sent to the Google backup.
-->
<full-backup-content>
    <exclude domain="file" path="sessions_history.json" />
    <exclude domain="file" path="weapons_library.json" />
    <exclude domain="file" path="ammo_library.json" />
    <exclude domain="file" path="session_photos" />
    <exclude domain="file" path="sessions_history.json.tmp" />
    <exclude domain="file" path="weapons_library.json.tmp" />
    <exclude domain="file" path="ammo_library.json.tmp" />
</full-backup-content>
